<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        CLAUDE.md rule 7 allows exactly three permissions and no others:
        INTERNET, ACCESS_NETWORK_STATE and com.android.vending.BILLING.

        Only ONE is declared so far, and only because something actually uses it.

        ACCESS_NETWORK_STATE: the feedback link checks for a connection before
        choosing between the browser and a mailto. Offline is the NORMAL
        condition in a workshop, and without this permission the check silently
        reports "offline" every time and nobody ever reaches the form.

        NOT declared yet, deliberately:
        - INTERNET is not needed to hand a URL to the browser via ACTION_VIEW;
          the browser has it. AdMob will need it in Phase 6.
        - BILLING arrives with Play Billing in Phase 6.

        An app that asks for permissions before it has any use for them is
        asking for trust it has not earned. Each one lands with the code that
        needs it.

        Sharing a cut plan uses FileProvider into the cache dir, so it needs no
        storage permission at all.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".StockCutApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StockCut">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StockCut"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Sharing a cut plan as an image, with NO storage permission.
            exported=false and grantUriPermissions mean only the app the user
            picks in the share sheet gets read access, and only to that one file.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
