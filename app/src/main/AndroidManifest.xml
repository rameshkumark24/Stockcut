<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        NO PERMISSIONS. CLAUDE.md rule 7 allows exactly three - INTERNET,
        ACCESS_NETWORK_STATE and com.android.vending.BILLING - and all three
        exist only to serve AdMob and Play Billing, which arrive in Phase 6.
        They are deliberately not declared yet: an app that asks for INTERNET
        before it has anything to send is asking for trust it has not earned.
        Add them in the same change as the SDKs that need them, never earlier.

        Sharing a cut plan uses FileProvider into the cache dir, so it needs no
        storage permission - see Phase 5's share step.
    -->

    <application
        android:name=".StockCutApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StockCut">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StockCut"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
