<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto-backup for Android 11 and below (checklist Phase 4, gap audit §B9).

    Losing a tradesman's saved jobs on a device swap is a 1-star review, and
    with no server this file is the only thing that prevents it (NFR-9: zero
    project loss across app update and device restore).

    Everything is included: the Room database holds the jobs, and the DataStore
    file holds their unit defaults and kerf. Restoring one without the other
    gives someone their jobs back in the wrong units.

    🔴 Verify with a real uninstall/reinstall cycle before release. This file
    being present is not evidence that it works.
-->
<full-backup-content>
    <include domain="database" path="stockcut.db" />
    <include domain="database" path="stockcut.db-wal" />
    <include domain="database" path="stockcut.db-shm" />
    <include domain="file" path="datastore/settings.preferences_pb" />
</full-backup-content>
