<?xml version="1.0" encoding="utf-8"?>
<!--
    The ONLY path this app ever shares.

    cache-path, not files-path or external-path: the shared PNG is disposable,
    lives in the app's own cache, and needs no storage permission. Nothing else
    is exposed - the Room database and the DataStore settings are deliberately
    absent, so a misbehaving receiving app cannot ask FileProvider for them.
-->
<paths>
    <cache-path name="shared" path="shared/" />
</paths>
