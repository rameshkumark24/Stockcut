<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto-backup and device-transfer rules for Android 12+ (API 31).

    Same content as backup_rules.xml, but split into the two cases the newer
    API distinguishes:

      cloud-backup   - Google Drive backup, used on reinstall
      device-transfer - direct phone-to-phone migration

    Both are included. A tradesman moving to a new phone must not lose the job
    list; that is the whole of NFR-9.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="stockcut.db" />
        <include domain="database" path="stockcut.db-wal" />
        <include domain="database" path="stockcut.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="stockcut.db" />
        <include domain="database" path="stockcut.db-wal" />
        <include domain="database" path="stockcut.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
