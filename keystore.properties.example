# Copy to keystore.properties and fill in. NEVER commit the real file.
#
# The upload keystore is unrecoverable. If you lose it, this app can never be
# updated on Google Play again. Back up the .jks file AND these passwords in
# two places off this machine (password manager + encrypted cloud).
#
# Generate:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias upload

storeFile=
storePassword=
keyAlias=upload
keyPassword=
